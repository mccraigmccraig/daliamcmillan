---
import { Picture } from "astro:assets";
import Layout from "@/layouts/Layout.astro";
import BookingButton from "@/components/BookingButton.astro";
import daliaPhoto from "@/assets/dalia-photo.jpg";
import { personSchema, breadcrumbSchema } from "@/config";

const description =
  "Meet Dalia McMillan, Solution Focused Hypnotherapist in Hassocks, Brighton, Lewes and online — 28 years' experience helping adults and children feel calmer.";

const schema = [
  personSchema(),
  breadcrumbSchema([{ name: "About", path: "/about/" }]),
];
---

<Layout
  title="About — Hypnotherapy, Hassocks & Brighton"
  description={description}
  schema={schema}
>
  <section class="relative overflow-hidden">
    <div class="absolute inset-0 -z-10 bg-gradient-warm opacity-70" aria-hidden="true"></div>
    <div class="container grid gap-16 py-20 lg:grid-cols-[1.1fr_1fr] lg:gap-20 lg:py-28">
      <div class="max-w-2xl">
        <p class="text-xs uppercase tracking-[0.2em] text-terracotta-500">About</p>
        <h1 class="mt-4 font-display text-5xl leading-[1.05] tracking-tight sm:text-6xl">
          Hello, I'm <em class="italic text-primary">Dalia McMillan.</em>
        </h1>

        <div class="mt-10 space-y-6 text-lg leading-relaxed text-foreground/85">
          <p>
            My journey into therapy began with the body. Over more than 28 years I've trained and worked in reflexology and structural body work — always drawn to helping people feel more at ease in themselves.
          </p>
          <p>
            Over time, I realised that true, lasting physical relief requires rewriting the subconscious patterns driving that stress — so my focus moved to the mind, with counselling training and years of meditation practice. Today I work in a modern, science-based way, through Solution Focused Hypnotherapy: an approach grounded in how the brain actually works, and where I've seen people make the deepest, most lasting change.
          </p>
          <p>
            I'm passionate about helping people move forward, feel calmer, and free themselves from patterns that no longer serve them. You can feel confident that I've trained with CPHT, an award-winning school, am fully insured, and am a member of the AfSFH (the Association for Solution Focused Hypnotherapy).
          </p>
          <p>
            I see clients in person in Hassocks, Brighton, Lewes and the surrounding villages, and online — whichever suits you best. I work with adults and children.
          </p>
        </div>

        <div class="mt-10">
          <BookingButton size="lg" label="Book a free consultation" />
        </div>
      </div>

      <div class="relative mx-auto w-2/3 lg:mx-0">
        <div class="relative aspect-[4/5] overflow-hidden rounded-[2rem] bg-cream-100 shadow-medium">
          <Picture
            src={daliaPhoto}
            formats={['webp']}
            widths={[800, 1200, 1920]}
            alt="Dalia McMillan, Solution Focused Hypnotherapist, smiling"
            loading="eager"
            class="h-full w-full object-cover"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-primary/20 via-transparent to-transparent" aria-hidden="true"></div>
        </div>
        <div class="absolute -bottom-6 -right-6 hidden sm:block max-w-[240px] rounded-2xl border border-cream-200 bg-background p-5 shadow-medium">
          <p class="text-xs uppercase tracking-[0.16em] text-terracotta-500">Credentials</p>
          <ul class="mt-3 space-y-1.5 text-sm leading-snug text-foreground">
            <li>Trained with CPHT</li>
            <li>Member of AfSFH</li>
            <li>Fully insured</li>
            <li>28 years in practice</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="py-24 sm:py-28 bg-cream-50 border-t border-cream-200/70">
    <div class="container grid gap-10 md:grid-cols-3">
      <div>
        <p class="text-xs uppercase tracking-[0.2em] text-terracotta-500">Where I work</p>
        <ul class="mt-3 space-y-1 font-display text-2xl leading-snug text-foreground">
          <li>Hassocks</li>
          <li>Burgess Hill</li>
          <li>Haywards Heath</li>
          <li>Lewes</li>
          <li>Brighton</li>
          <li>Crawley and surrounding villages</li>
        </ul>
      </div>
      <div>
        <p class="text-xs uppercase tracking-[0.2em] text-terracotta-500">Who I work with</p>
        <p class="mt-3 font-display text-2xl leading-snug text-foreground">With adults, teenagers and children.</p>
      </div>
      <div>
        <p class="text-xs uppercase tracking-[0.2em] text-terracotta-500">How we begin</p>
        <p class="mt-3 font-display text-2xl leading-snug text-foreground">With a call to see how I can help you, and then a free 1-hour initial consultation to explain why you are feeling the way you do and what we can do about it.</p>
      </div>
    </div>
  </section>
</Layout>
