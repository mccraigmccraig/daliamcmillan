---
import Layout from "@/layouts/Layout.astro";
import BookingButton from "@/components/BookingButton.astro";

const description =
  "Get in touch with Dalia McMillan — Solution Focused Hypnotherapy in Hassocks, Lewes, Brighton and the surrounding villages, and online. Free initial consultation. Email dalia@daliamcmillan.uk.";
---

<Layout title="Contact" description={description}>
  <section class="relative overflow-hidden">
    <div class="absolute inset-0 -z-10 bg-gradient-warm opacity-70" aria-hidden="true"></div>
    <div class="container py-20 lg:py-28">
      <div class="max-w-3xl">
        <p class="text-xs uppercase tracking-[0.2em] text-terracotta-500">Contact</p>
        <h1 class="mt-4 font-display text-5xl leading-[1.05] tracking-tight sm:text-6xl">
          Let's <em class="italic text-primary">talk.</em>
        </h1>
        <p class="mt-8 text-lg leading-relaxed text-foreground/85 sm:text-xl">
          The easiest first step is a free initial consultation — no obligation, just a conversation about what you'd like to be different, and whether we'd be a good fit to work together.
        </p>
      </div>
    </div>
  </section>

  <section class="pb-24 sm:pb-32">
    <div class="container">
      <div class="mx-auto grid max-w-4xl gap-6 md:grid-cols-2">
        <!-- Book directly -->
        <div class="rounded-[1.75rem] border border-cream-200 bg-cream-50 p-8 shadow-soft">
          <p class="text-xs uppercase tracking-[0.2em] text-terracotta-500">Book directly</p>
          <h2 class="mt-3 font-display text-2xl leading-snug text-foreground">
            Book your free consultation on Calendly
          </h2>
          <p class="mt-3 text-[15px] leading-relaxed text-muted-foreground">
            Choose a time that works for you — everything's in one place.
          </p>
          <div class="mt-6">
            <BookingButton size="lg" label="Open Calendly" />
          </div>
        </div>

        <!-- Call, text or email -->
        <div class="rounded-[1.75rem] border border-cream-200 bg-background p-8 shadow-soft">
          <p class="text-xs uppercase tracking-[0.2em] text-terracotta-500">Rather talk?</p>
          <h2 class="mt-3 font-display text-2xl leading-snug text-foreground">
            Call, text or email me
          </h2>
          <p class="mt-3 text-[15px] leading-relaxed text-muted-foreground">
            Sometimes it's easier just to talk. If I'm with a client I can't always answer straight away — leave a message or a text and I'll call you back. Or email, and I'll usually reply the same day.
          </p>
          <div class="mt-5 space-y-2.5">
            <a
              href="tel:+447826323155"
              class="block text-lg font-medium text-primary underline underline-offset-4 hover:text-terracotta-500 transition-colors"
            >
              07826 323155
            </a>
            <a
              href="mailto:dalia@daliamcmillan.uk"
              class="block break-all text-lg font-medium text-primary underline underline-offset-4 hover:text-terracotta-500 transition-colors"
            >
              dalia@daliamcmillan.uk
            </a>
          </div>
          <dl class="mt-6 space-y-4 border-t border-cream-200 pt-6 text-[15px]">
            <div>
              <dt class="font-medium text-foreground">Where I work</dt>
              <dd class="mt-1 text-muted-foreground">Hassocks, Lewes, Brighton &amp; the surrounding villages, plus online sessions.</dd>
            </div>
            <div>
              <dt class="font-medium text-foreground">Free initial consultation</dt>
              <dd class="mt-1 text-muted-foreground">
                Includes a simple explanation of the neuroscience, so you feel confident from the very first step.
              </dd>
            </div>
          </dl>
          <p class="mt-6 text-xs leading-relaxed text-muted-foreground">
            Please note this isn't an emergency service. If you need urgent help now, call 999, or Samaritans free any time on 116 123.
          </p>
        </div>
      </div>
    </div>
  </section>
</Layout>
