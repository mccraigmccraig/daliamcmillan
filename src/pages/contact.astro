---
import Layout from "@/layouts/Layout.astro";
import { Picture } from "astro:assets";
import BookingButton from "@/components/BookingButton.astro";
import heelerPhoto from "@/assets/heeler-centre.png";
import somaticPhoto from "@/assets/somatic-centre.jpg";
import { contactPageSchema, breadcrumbSchema } from "@/config";

const description =
  "Get in touch with Dalia McMillan — hypnotherapy in Hassocks, Brighton, Lewes and online. Book a free initial consultation, or call, text or email me today.";

const schema = [
  contactPageSchema(description),
  breadcrumbSchema([{ name: "Contact", path: "/contact/" }]),
];
---

<Layout
  title="Book a Free Hypnotherapy Consultation"
  description={description}
  schema={schema}
>
  <section class="relative overflow-hidden">
    <div class="absolute inset-0 -z-10 bg-gradient-warm opacity-70" aria-hidden="true"></div>
    <div class="container py-20 lg:py-28">
      <div class="max-w-3xl">
        <p class="text-xs uppercase tracking-[0.2em] text-terracotta-500">Contact</p>
        <h1 class="mt-4 font-display text-5xl leading-[1.05] tracking-tight sm:text-6xl">
          Let's <em class="italic text-primary">talk.</em>
        </h1>
        <p class="mt-8 text-lg leading-relaxed text-foreground/85 sm:text-xl">
          The easiest first step is a free initial consultation — no obligation, just a conversation about what you'd like to be different, and whether we'd be a good fit to work together.
        </p>
      </div>
    </div>
  </section>

  <section class="pb-24 sm:pb-32">
    <div class="container">
      <div class="mx-auto grid max-w-4xl gap-6 md:grid-cols-2">
        <!-- Book directly -->
        <div class="rounded-[1.75rem] border border-cream-200 bg-cream-50 p-8 shadow-soft">
          <p class="text-xs uppercase tracking-[0.2em] text-terracotta-500">Book directly</p>
          <h2 class="mt-3 font-display text-2xl leading-snug text-foreground">
            Book your free consultation on Calendly
          </h2>
          <p class="mt-3 text-[15px] leading-relaxed text-muted-foreground">
            Choose a time that works for you — everything's in one place.
          </p>
          <div class="mt-6">
            <BookingButton size="lg" label="Open Calendly" />
          </div>
        </div>

        <!-- Call, text or email -->
        <div class="rounded-[1.75rem] border border-cream-200 bg-background p-8 shadow-soft">
          <p class="text-xs uppercase tracking-[0.2em] text-terracotta-500">Rather talk?</p>
          <h2 class="mt-3 font-display text-2xl leading-snug text-foreground">
            Call, text or email me
          </h2>
          <p class="mt-3 text-[15px] leading-relaxed text-muted-foreground">
            Sometimes it's easier just to talk. If I'm with a client I can't always answer straight away — leave a message or a text and I'll call you back. Or email, and I'll usually reply the same day.
          </p>
          <div class="mt-5 space-y-2.5">
            <a
              href="tel:+447826323155"
              class="block text-lg font-medium text-primary underline underline-offset-4 hover:text-terracotta-500 transition-colors"
            >
              07826 323155
            </a>
            <a
              href="mailto:daliamcmillantherapy@gmail.com"
              class="block break-all text-lg font-medium text-primary underline underline-offset-4 hover:text-terracotta-500 transition-colors"
            >
              daliamcmillantherapy@gmail.com
            </a>
          </div>
          <div class="mt-6">
            <a
              href="/dalia-mcmillan.vcf"
              class="inline-flex items-center gap-2.5 rounded-full bg-primary px-5 py-3 text-[15px] font-medium text-primary-foreground shadow-soft transition-all hover:-translate-y-0.5 hover:shadow-medium"
            >
              <svg xmlns="http://www.w3.org/2000/svg" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/>
                <circle cx="9" cy="7" r="4"/>
                <line x1="19" y1="8" x2="19" y2="14"/>
                <line x1="22" y1="11" x2="16" y2="11"/>
              </svg>
              Save my contact
            </a>
            <p class="mt-2.5 text-xs leading-relaxed text-muted-foreground">
              One tap adds my name, number, email and photo to your phone's contacts.
            </p>
          </div>
          <dl class="mt-6 space-y-4 border-t border-cream-200 pt-6 text-[15px]">
            <div>
              <dt class="font-medium text-foreground">Where I work</dt>
              <dd class="mt-1 text-muted-foreground">Hassocks, Lewes, Brighton &amp; the surrounding villages, plus online sessions.</dd>
            </div>
            <div>
              <dt class="font-medium text-foreground">Free initial consultation</dt>
              <dd class="mt-1 text-muted-foreground">
                Includes a simple explanation of the neuroscience, so you feel confident from the very first step.
              </dd>
            </div>
          </dl>
          <p class="mt-6 text-xs leading-relaxed text-muted-foreground">
            Please note this isn't an emergency service. If you need urgent help now, call 999, or Samaritans free any time on 116 123.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Where I practise -->
  <section aria-label="Practice locations" class="pb-24 sm:pb-32">
    <div class="container">
      <div class="mx-auto max-w-4xl">
        <div class="text-center">
          <p class="text-xs uppercase tracking-[0.2em] text-terracotta-500">In person &amp; online</p>
          <h2 class="mt-3 font-display text-3xl leading-tight tracking-tight sm:text-4xl">
            Where I practise
          </h2>
          <p class="mt-4 text-[15px] leading-relaxed text-muted-foreground sm:text-base">
            You can see me in person in a few different settings across Sussex — whichever feels most comfortable for you — or online, wherever you are.
          </p>
        </div>

        <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          <div class="flex flex-col overflow-hidden rounded-[1.75rem] border border-cream-200 bg-background shadow-soft">
            <Picture
              src={heelerPhoto}
              formats={['webp']}
              widths={[400, 800]}
              sizes="(min-width: 768px) 400px, 100vw"
              alt="Reception signage at The Heeler Centre in Hassocks"
              class="aspect-[16/10] w-full object-cover"
            />
            <div class="flex flex-1 flex-col p-8">
              <h3 class="font-display text-xl leading-snug text-foreground">The Heeler Centre</h3>
              <p class="mt-1 text-xs uppercase tracking-[0.18em] text-terracotta-500">Hassocks</p>
              <address class="mt-4 flex-1 not-italic text-[15px] leading-relaxed text-muted-foreground">
                Bridge House, Station Approach East,<br />Hassocks BN6 8HN
              </address>
              <a
                href="https://www.google.com/maps/search/?api=1&query=The+Heeler+Centre+Bridge+House+Station+Approach+East+Hassocks+BN6+8HN"
                target="_blank"
                rel="noopener"
                class="mt-5 inline-flex items-center gap-1.5 text-sm font-medium text-primary hover:text-terracotta-500 transition-colors"
              >
                View on map
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17 17 7"/><path d="M7 7h10v10"/></svg>
              </a>
            </div>
          </div>

          <div class="flex flex-col overflow-hidden rounded-[1.75rem] border border-cream-200 bg-background shadow-soft">
            <div class="flex aspect-[16/10] w-full items-center justify-center bg-gradient-warm" aria-hidden="true">
              <svg xmlns="http://www.w3.org/2000/svg" width="46" height="46" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="text-primary"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
            </div>
            <div class="flex flex-1 flex-col p-8">
              <h3 class="font-display text-xl leading-snug text-foreground">My home practice</h3>
              <p class="mt-1 text-xs uppercase tracking-[0.18em] text-terracotta-500">Hassocks</p>
              <p class="mt-4 flex-1 text-[15px] leading-relaxed text-muted-foreground">
                A warm, homely space in Hassocks — a gentle alternative if a clinical setting isn't for you. The address is shared when you book.
              </p>
            </div>
          </div>

          <div class="flex flex-col overflow-hidden rounded-[1.75rem] border border-cream-200 bg-background shadow-soft">
            <Picture
              src={somaticPhoto}
              formats={['webp']}
              widths={[400, 800]}
              sizes="(min-width: 768px) 400px, 100vw"
              alt="A calm consultation room at The Somatic Therapies Centre in Hove"
              class="aspect-[16/10] w-full object-cover"
            />
            <div class="flex flex-1 flex-col p-8">
              <h3 class="font-display text-xl leading-snug text-foreground">The Somatic Therapies Centre</h3>
              <p class="mt-1 text-xs uppercase tracking-[0.18em] text-terracotta-500">Hove</p>
              <address class="mt-4 flex-1 not-italic text-[15px] leading-relaxed text-muted-foreground">
                81 Church Road,<br />Hove BN3 2BB
              </address>
              <a
                href="https://www.google.com/maps/search/?api=1&query=The+Somatic+Therapies+Centre+81+Church+Road+Hove+BN3+2BB"
                target="_blank"
                rel="noopener"
                class="mt-5 inline-flex items-center gap-1.5 text-sm font-medium text-primary hover:text-terracotta-500 transition-colors"
              >
                View on map
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17 17 7"/><path d="M7 7h10v10"/></svg>
              </a>
            </div>
          </div>
        </div>

        <p class="mt-8 text-center text-[15px] leading-relaxed text-muted-foreground">
          Prefer to meet from the comfort of home? I also offer <strong class="font-medium text-foreground">online sessions</strong> over video — just as warm and effective, wherever you are.
        </p>
      </div>
    </div>
  </section>
</Layout>
