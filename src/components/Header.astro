---
import BookingButton from "@/components/BookingButton.astro";
import KidsLogo from "@/components/KidsLogo.astro";
import MainLogo from "@/components/MainLogo.astro";

const navLinks = [
  { href: "/about/", label: "About" },
  { href: "/how-it-works/", label: "How it works" },
  { href: "/what-i-can-help-with/", label: "What I help with" },
  { href: "/children/", label: "Children & teens" },
  { href: "/contact/", label: "Contact" },
];

const pathname = Astro.url.pathname;
const isActive = (href: string) =>
  href === "/" ? pathname === "/" : pathname.startsWith(href);

const isChildren = pathname.startsWith("/children/");
---

<header class="sticky top-0 z-40 w-full border-b border-cream-200/70 bg-background/85 backdrop-blur-md">
  <div class="container flex min-h-24 items-center justify-between gap-6 py-5">
    <a
      href="/"
      class="group flex items-center gap-2.5"
      aria-label="Dalia McMillan — home"
    >
      {isChildren ? (
        <KidsLogo size={116} class="shrink-0 transition-transform duration-500 group-hover:-rotate-[6deg]" />
      ) : (
        <MainLogo size={100} class="shrink-0 transition-transform duration-500 group-hover:-rotate-[4deg]" />
      )}
      <span class="flex flex-col leading-tight">
        <span class="font-display text-2xl md:text-3xl leading-none tracking-tight text-foreground">Dalia McMillan</span>
        <span class="block text-[11px] md:text-xs uppercase tracking-[0.1em] md:tracking-[0.14em] text-muted-foreground mt-1.5">Solution Focused Hypnotherapy · Talking Therapy</span>
      </span>
    </a>

    <nav aria-label="Primary" class="hidden lg:flex items-center gap-8">
      {navLinks.map((link) => (
        <a
          href={link.href}
          class:list={[
            "text-[15px] transition-colors",
            link.href === "/children/" ? "flex items-center gap-2" : "",
            isActive(link.href)
              ? "text-primary font-medium"
              : "text-muted-foreground hover:text-foreground",
          ]}
          aria-current={isActive(link.href) ? "page" : undefined}
        >
          {link.href === "/children/" && <KidsLogo size={50} class="shrink-0" />}
          {link.label}
        </a>
      ))}
    </nav>

    <div class="hidden lg:block">
      <BookingButton label="Book Now" size="md" />
    </div>

    <button
      id="nav-toggle"
      type="button"
      class="lg:hidden inline-flex h-11 w-11 items-center justify-center rounded-full border border-cream-300 text-primary hover:bg-cream-100"
      aria-controls="mobile-nav"
      aria-expanded="false"
      aria-label="Open menu"
    >
      <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" data-open>
        <line x1="4" y1="7" x2="20" y2="7"/>
        <line x1="4" y1="12" x2="20" y2="12"/>
        <line x1="4" y1="17" x2="20" y2="17"/>
      </svg>
      <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" data-close class="hidden">
        <line x1="6" y1="6" x2="18" y2="18"/>
        <line x1="6" y1="18" x2="18" y2="6"/>
      </svg>
    </button>
  </div>

  <nav
    id="mobile-nav"
    aria-label="Primary mobile"
    class="hidden lg:hidden border-t border-cream-200/70 bg-background"
  >
    <ul class="container flex flex-col gap-1 py-4">
      {navLinks.map((link) => (
        <li>
          <a
            href={link.href}
            class:list={[
              "flex items-center gap-2 rounded-md px-3 py-3 text-base transition-colors",
              isActive(link.href)
                ? "text-primary font-medium bg-cream-100"
                : "text-foreground hover:bg-cream-100",
            ]}
            aria-current={isActive(link.href) ? "page" : undefined}
          >
            {link.label}
            {link.href === "/children/" && <KidsLogo size={22} class="shrink-0" />}
          </a>
        </li>
      ))}
      <li class="pt-2">
        <BookingButton label="Book Now" class="w-full" />
      </li>
    </ul>
  </nav>
</header>

<script>
  const toggle = document.getElementById("nav-toggle");
  const mobileNav = document.getElementById("mobile-nav");
  const openIcon = toggle?.querySelector("[data-open]");
  const closeIcon = toggle?.querySelector("[data-close]");

  if (toggle && mobileNav && openIcon && closeIcon) {
    toggle.addEventListener("click", () => {
      const isOpen = mobileNav.classList.toggle("hidden") === false;
      toggle.setAttribute("aria-expanded", String(isOpen));
      toggle.setAttribute("aria-label", isOpen ? "Close menu" : "Open menu");
      openIcon.classList.toggle("hidden", isOpen);
      closeIcon.classList.toggle("hidden", !isOpen);
    });
  }
</script>
