---
const year = new Date().getFullYear();

const links = [
  { href: "/about/", label: "About" },
  { href: "/how-it-works/", label: "How it works" },
  { href: "/what-i-can-help-with/", label: "What I help with" },
  { href: "/deep-relaxation/", label: "Free relaxation" },
  { href: "/contact/", label: "Contact" },
];

const socials = [
  {
    label: "Follow on Facebook",
    href: "https://www.facebook.com/profile.php?id=61593327893101",
  },
  {
    label: "Follow on Instagram",
    href: "https://www.instagram.com/daliamcmillantherapy",
  },
];
---

<footer class="mt-24 border-t border-cream-200/70 bg-cream-50">
  <div class="container py-14">
    <div class="grid gap-10 md:grid-cols-3 md:gap-8">
      <div>
        <a href="/" class="inline-flex items-center gap-2.5" aria-label="Dalia McMillan — home">
          <span class="grid h-9 w-9 place-items-center rounded-full bg-primary text-primary-foreground shadow-soft">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M12 2c1.5 3 4.5 5 7 5-1.5 3-1.5 6 0 9-2.5 0-5.5 2-7 5-1.5-3-4.5-5-7-5 1.5-3 1.5-6 0-9 2.5 0 5.5-2 7-5Z"/>
            </svg>
          </span>
          <span class="font-display text-2xl leading-none tracking-tight">Dalia McMillan</span>
        </a>
        <p class="mt-4 max-w-xs text-sm leading-relaxed text-muted-foreground">
          Solution Focused Hypnotherapy with Dalia McMillan. In Hassocks, Brighton, Lewes and the surrounding villages, or online wherever you are.
        </p>

        <ul class="mt-6 flex items-center gap-3">
          {socials.map((social) => (
            <li>
              <a
                href={social.href}
                target="_blank"
                rel="noopener"
                aria-label={social.label}
                class="grid h-10 w-10 place-items-center rounded-full border border-cream-300 bg-background text-foreground shadow-soft transition-all hover:-translate-y-0.5 hover:border-sage-300 hover:text-primary hover:shadow-medium"
              >
                {social.label.includes("Facebook") ? (
                  <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M14 13.5h2.5l1-4H14v-2c0-1.03 0-2 2-2h1.5V2.14c-.326-.043-1.557-.14-2.857-.14C11.928 2 10 3.657 10 6.7v2.8H7v4h3V22h4v-8.5Z"/></svg>
                ) : (
                  <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="2" width="20" height="20" rx="5.5"/><circle cx="12" cy="12" r="4.2"/><circle cx="17.4" cy="6.6" r="1.1" fill="currentColor" stroke="none"/></svg>
                )}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <nav aria-label="Footer" class="md:justify-self-center">
        <h2 class="font-display text-sm uppercase tracking-[0.18em] text-muted-foreground">Explore</h2>
        <ul class="mt-4 space-y-2.5 text-sm">
          {links.map((link) => (
            <li>
              <a href={link.href} class="text-foreground hover:text-primary transition-colors">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <div class="md:justify-self-end md:text-right">
        <h2 class="font-display text-sm uppercase tracking-[0.18em] text-muted-foreground">Get in touch</h2>
        <ul class="mt-4 space-y-2.5 text-sm">
          <li>
            <a href="mailto:daliamcmillantherapy@gmail.com" class="text-foreground hover:text-primary transition-colors">
              daliamcmillantherapy@gmail.com
            </a>
          </li>
          <li>
            <a href="/dalia-mcmillan.vcf" class="inline-flex items-center gap-1.5 text-foreground hover:text-primary transition-colors">
              <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><line x1="19" y1="8" x2="19" y2="14"/><line x1="22" y1="11" x2="16" y2="11"/>
              </svg>
              Save my contact
            </a>
          </li>
          <li class="text-muted-foreground">Hassocks, Brighton, Lewes &amp; online</li>
          <li>
            <a
              href="https://calendly.com/daliamcdalia"
              target="_blank"
              rel="noopener"
              class="text-terracotta-500 hover:text-terracotta-400 transition-colors"
            >
              Book on Calendly →
            </a>
          </li>
        </ul>
      </div>
    </div>

    <div class="mt-12 flex flex-col-reverse gap-3 border-t border-cream-200 pt-6 text-xs text-muted-foreground md:flex-row md:items-center md:justify-between">
      <p>© {year} Dalia McMillan · Hassocks &amp; online</p>
      <p class="tracking-wide">Trained with CPHT · Member of AfSFH · Fully insured</p>
    </div>
  </div>
</footer>
